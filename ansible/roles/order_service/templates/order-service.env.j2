# {{ ansible_managed }}
# Delivered by Ansible to {{ config_dir }}/order-service.env, mode 0640, owned by
# {{ app_user }}. systemd loads it as this service's environment. This is the ONLY
# place the DB password lands — on the box, not in the repo.
KENTE_ENV={{ env_name }}
APP_PORT={{ app_port }}
DB_HOST={{ db_host }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
