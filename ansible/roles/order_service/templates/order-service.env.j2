# {{ ansible_managed }}
# Delivered by Ansible to {{ order_service_config_dir }}/order-service.env, mode
# 0640, owned by {{ order_service_app_user }}. systemd loads it as this service's
# environment. This is the ONLY place the DB password lands — on the box, not the repo.
KENTE_ENV={{ order_service_env_name }}
APP_PORT={{ order_service_app_port }}
DB_HOST={{ order_service_db_host }}
DB_NAME={{ order_service_db_name }}
DB_USER={{ order_service_db_user }}
DB_PASSWORD={{ order_service_db_password }}
